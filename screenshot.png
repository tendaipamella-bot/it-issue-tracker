<!DOCTYPE html>
<!-- saved from url=(0053)https://tendaipamella-bot.github.io/it-issue-tracker/ -->
<html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
	
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>IT Issue Tracker</title>
	<style>
		:root{font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;color:#172033;background:#f4f7fb}
		*{box-sizing:border-box}body{margin:0}.shell{max-width:1200px;margin:auto;padding:28px 18px}
		header{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:24px}h1{margin:0;font-size:28px}h2{margin:0 0 16px;font-size:18px}p{color:#657083}.brand{display:flex;align-items:center;gap:12px}.logo{background:#2563eb;color:white;border-radius:10px;padding:10px 12px;font-weight:800}
		.grid{display:grid;grid-template-columns:330px 1fr;gap:20px}.card{background:white;border:1px solid #e4e9f1;border-radius:14px;padding:20px;box-shadow:0 4px 18px #263b5b0b}
		label{display:block;font-size:13px;font-weight:700;margin:13px 0 6px}input,select,textarea,button{font:inherit}input,select,textarea{width:100%;padding:10px 11px;border:1px solid #d7deea;border-radius:8px;background:#fff}textarea{min-height:90px;resize:vertical}
		button{border:0;border-radius:8px;padding:10px 14px;cursor:pointer;font-weight:700}.primary{background:#2563eb;color:#fff;width:100%;margin-top:16px}.secondary{background:#eaf1ff;color:#1854c7}.danger{background:#fff0f0;color:#c53030;padding:7px 9px;font-size:12px}.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px}.toolbar input{flex:1;min-width:180px}.toolbar select{width:auto;min-width:140px}
		.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:18px}.stat{background:#f7f9fc;border-radius:10px;padding:13px}.stat strong{display:block;font-size:24px}.stat span{font-size:12px;color:#657083}.issue{border:1px solid #e4e9f1;border-radius:11px;padding:15px;margin:10px 0}.issue-top{display:flex;justify-content:space-between;gap:10px}.issue h3{margin:0 0 7px;font-size:16px}.issue p{margin:5px 0 12px;font-size:14px}.meta{display:flex;gap:9px;flex-wrap:wrap;align-items:center;color:#657083;font-size:12px}.badge{padding:4px 8px;border-radius:99px;font-weight:700;font-size:11px}.open{background:#fff4d6;color:#946200}.progress{background:#e7f0ff;color:#2457a6}.resolved{background:#def7e7;color:#187344}.empty{text-align:center;padding:35px;color:#657083}@media(max-width:760px){.grid{grid-template-columns:1fr}header{align-items:flex-start;flex-direction:column}}
	</style>
</head>
<body>
	<main class="shell">
		<header><div class="brand"><div class="logo">IT</div><div><h1>Issue Tracker</h1><p style="margin:3px 0 0">Central support desk for your team</p></div></div><button class="secondary" onclick="document.getElementById(&#39;title&#39;).focus()">+ New issue</button></header>
		<div class="grid">
			<section class="card"><h2>Log an issue</h2>
				<form id="issueForm">
					<label for="title">Issue title</label><input id="title" required="" maxlength="90" placeholder="e.g. Cannot access shared drive">
					<label for="reporter">Reported by</label><input id="reporter" required="" placeholder="Name or email">
					<label for="priority">Priority</label><select id="priority"><option>Low</option><option selected="">Medium</option><option>High</option><option>Urgent</option></select>
					<label for="assignee">Assign to</label><input id="assignee" placeholder="Team member (optional)">
					<label for="description">Description</label><textarea id="description" required="" placeholder="Add useful details, error messages, or steps to reproduce"></textarea>
					<button class="primary">Create issue</button>
				</form>
			</section>
			<section class="card"><div class="stats"><div class="stat"><strong id="total">5</strong><span>Total issues</span></div><div class="stat"><strong id="active">4</strong><span>Active</span></div><div class="stat"><strong id="done">1</strong><span>Resolved</span></div></div>
				<div class="toolbar"><input id="search" placeholder="Search issues..."><select id="filter"><option value="all">All statuses</option><option value="Open">Open</option><option value="In Progress">In Progress</option><option value="Resolved">Resolved</option></select><select id="sort"><option value="new">Newest first</option><option value="priority">Priority</option></select></div>
				<div id="issues"><article class="issue"><div class="issue-top"><div><h3>cannot access shared drive</h3><div class="meta"><span class="badge open">Open</span><span>High priority</span><span>• james.k@co.com</span></div></div><button class="danger" onclick="removeIssue(&#39;1788896907205&#39;)">Delete</button></div><p>User gets "Access denied" error when trying to open /sever/shared/finance. Happening since morning. Tried restarting PC</p><div class="meta"><span>Assigned: IT Support</span><span>Created 9/8/2026</span><select aria-label="Update status" onchange="updateStatus(&#39;1788896907205&#39;,this.value)"><option selected="">Open</option><option>In Progress</option><option>Resolved</option></select></div></article><article class="issue"><div class="issue-top"><div><h3>Printer not responding on 3rd floor</h3><div class="meta"><span class="badge progress">In Progress</span><span>Medium priority</span><span>• Leo.t@co.com</span></div></div><button class="danger" onclick="removeIssue(&#39;1788896585372&#39;)">Delete</button></div><p>hp LaserJet 4200 shows "offline" status. Network cable is plugged in. other printers on the same floor are working properly.</p><div class="meta"><span>Assigned: Hardware team</span><span>Created 9/8/2026</span><select aria-label="Update status" onchange="updateStatus(&#39;1788896585372&#39;,this.value)"><option>Open</option><option selected="">In Progress</option><option>Resolved</option></select></div></article><article class="issue"><div class="issue-top"><div><h3>Software install request- Adobe Photoshop</h3><div class="meta"><span class="badge open">Open</span><span>Medium priority</span><span>• design.team@co.com</span></div></div><button class="danger" onclick="removeIssue(&#39;1788896203309&#39;)">Delete</button></div><p>Need Adobe Photoshop 2025 for marketing team. 3 licenses available. Urgent for campaign launching next week.</p><div class="meta"><span>Assigned: IT Support</span><span>Created 9/8/2026</span><select aria-label="Update status" onchange="updateStatus(&#39;1788896203309&#39;,this.value)"><option selected="">Open</option><option>In Progress</option><option>Resolved</option></select></div></article><article class="issue"><div class="issue-top"><div><h3>Email signature not updating</h3><div class="meta"><span class="badge resolved">Resolved</span><span>Low priority</span><span>• Linda Johnson</span></div></div><button class="danger" onclick="removeIssue(&#39;1788891296546&#39;)">Delete</button></div><p>Updated signature in outlook but old signature still appears on mobile app. Cleared cache but issue persists.</p><div class="meta"><span>Assigned: Leonard Meki</span><span>Created 9/8/2026</span><select aria-label="Update status" onchange="updateStatus(&#39;1788891296546&#39;,this.value)"><option>Open</option><option>In Progress</option><option selected="">Resolved</option></select></div></article><article class="issue"><div class="issue-top"><div><h3>VPN connection drops every 10minutes</h3><div class="meta"><span class="badge open">Open</span><span>High priority</span><span>• Aleck.zee@company.com</span></div></div><button class="danger" onclick="removeIssue(&#39;1788890731173&#39;)">Delete</button></div><p>Remote worker using Cisco VPN. Connection disconnects randomly. Error: "Reason 442: Failed to enable virtual adaptor''.
</p><div class="meta"><span>Assigned: Network Admin</span><span>Created 9/8/2026</span><select aria-label="Update status" onchange="updateStatus(&#39;1788890731173&#39;,this.value)"><option selected="">Open</option><option>In Progress</option><option>Resolved</option></select></div></article></div>
			</section>
		</div>
	</main>
	<script>
		const key='it-issues'; let issues=JSON.parse(localStorage.getItem(key)||'[]');
		const $=id=>document.getElementById(id); const priorityOrder={Urgent:0,High:1,Medium:2,Low:3};
		function save(){localStorage.setItem(key,JSON.stringify(issues)); render()}
		function render(){const term=$('search').value.toLowerCase(), status=$('filter').value; let list=issues.filter(i=>(status==='all'||i.status===status)&&(`${i.title} ${i.description} ${i.reporter} ${i.assignee}`.toLowerCase().includes(term))); list.sort((a,b)=>$('sort').value==='priority'?priorityOrder[a.priority]-priorityOrder[b.priority]:b.created-a.created); $('total').textContent=issues.length; $('active').textContent=issues.filter(i=>i.status!=='Resolved').length; $('done').textContent=issues.filter(i=>i.status==='Resolved').length; $('issues').innerHTML=list.length?list.map(i=>`<article class="issue"><div class="issue-top"><div><h3>${esc(i.title)}</h3><div class="meta"><span class="badge ${i.status==='Resolved'?'resolved':i.status==='In Progress'?'progress':'open'}">${i.status}</span><span>${i.priority} priority</span><span>• ${esc(i.reporter)}</span></div></div><button class="danger" onclick="removeIssue('${i.id}')">Delete</button></div><p>${esc(i.description)}</p><div class="meta"><span>Assigned: ${esc(i.assignee||'Unassigned')}</span><span>Created ${new Date(i.created).toLocaleDateString()}</span><select aria-label="Update status" onchange="updateStatus('${i.id}',this.value)"><option ${i.status==='Open'?'selected':''}>Open</option><option ${i.status==='In Progress'?'selected':''}>In Progress</option><option ${i.status==='Resolved'?'selected':''}>Resolved</option></select></div></article>`).join(''):'<div class="empty">No issues match your filters.</div>'}
		function esc(s){return String(s).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}
		$('issueForm').onsubmit=e=>{e.preventDefault();issues.push({id:Date.now().toString(),title:$('title').value,reporter:$('reporter').value,priority:$('priority').value,assignee:$('assignee').value,description:$('description').value,status:'Open',created:Date.now()});e.target.reset();save()};
		function updateStatus(id,status){let i=issues.find(x=>x.id===id);if(i){i.status=status;save()}} function removeIssue(id){if(confirm('Delete this issue?')){issues=issues.filter(i=>i.id!==id);save()}}
		['search','filter','sort'].forEach(id=>$(id).oninput=render); render();
	</script>

 
</body></html>